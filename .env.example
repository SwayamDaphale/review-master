# ---- Application & Environment ----
APP_ENV=development
DEBUG=true
LOG_LEVEL=info
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Required secrets (generate with: openssl rand -hex 32) ----
JWT_SECRET=change-me-dev-only
API_KEY_PEPPER=change-me-dev-only

# ---- PostgreSQL Database URL ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reviewmaster
REDIS_URL=redis://localhost:6379/0

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reviewmaster
POSTGRES_PORT=5433

# ---- Object storage (dev SeaweedFS; use real credentials + AWS S3/R2/GCS in prod) ----
S3_BUCKET_EVIDENCE=rm-evidence
S3_ACCESS_KEY=devaccess
S3_SECRET_KEY=devsecret

# ---- Auth ----
AUTH_PROVIDER=builtin              # builtin | keycloak (profile: enterprise-auth)
OIDC_ISSUER_URL=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- LLM access (backend talks to ONE OpenAI-compatible endpoint) ----
# Mode A (default, local, no keys):   Ollama   -> profile: local-llm
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_FAST=qwen3.5:latest
LLM_MODEL_STRONG=qwen3.5:latest
EMBEDDING_MODEL=bge-m3
# Mode B (recommended for cloud models): LiteLLM gateway -> profile: llm-gateway
#   LLM_BASE_URL=http://litellm:4000/v1
#   LLM_API_KEY=<LITELLM_MASTER_KEY or a virtual key>
#   LLM_MODEL_FAST=rm-fast
#   LLM_MODEL_STRONG=rm-strong
#   EMBEDDING_MODEL=rm-embed
LITELLM_MASTER_KEY=sk-dev-change-me
# Provider keys are read ONLY by the gateway container (leave blank if unused):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_PORT=11434
COST_CEILING_USD=0.05

# ---- Feature flags ----
FEATURE_RAG_ENABLED=false          # true after starting profile: rag
FEATURE_UPLOAD_SCAN=false          # true after starting profile: scan

# ---- Email ----
EMAIL_FROM=no-reply@reviewmaster.local

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=admin

# ---- Graph (V3, profile: graph) ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---- Tools (profile: tools) ----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
