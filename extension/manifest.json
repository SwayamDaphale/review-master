{
  "manifest_version": 3,
  "name": "Review Master - Smartphone Extractor",
  "version": "1.0.0",
  "description": "User-initiated Amazon India smartphone information extraction and verification tool.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Review Master - Extract Smartphone Info"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://amazon.in/*"
  ]
}
